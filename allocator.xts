# XTS Allocator Commands
# 
# Architecture:
#   - Server returns JSON only (no formatting)
#   - This .xts file contains all presentation logic (inline Python formatters)
#   - Server can upgrade capabilities independently of client
#   - No external file dependencies - everything self-contained
#
# Quick Start:
#   1. Register server: xts alias add allocator http://server:5000/xts_allocator.xts
#   2. List devices:    xts allocator list
#   3. Allocate:        xts allocator alloc_by_id you@example.com 5 2h
#   4. Release:         xts allocator release you@example.com 5
#
# Environment Variables:
#   XTS_ALLOCATOR_SERVER - Override server URL (default: http://localhost:5000)
#   XTS_ALLOCATOR_TOKEN - Engineer/admin JWT for protected test commands
#   XTS_ALLOCATOR_ADMIN_TOKEN - Admin JWT for state changes (falls back to XTS_ALLOCATOR_TOKEN)
#   XTS_ALLOCATOR_USER_EMAIL - Optional user email attached to start_test requests
#   XTS_ALLOCATOR_USER_NAME - Optional display name used for allocations
#   XTS_ALLOCATOR_USER_OFFICE - Optional office/site tag for user profile
#   XTS_ALLOCATOR_USER_TEAM - Optional team/project tag for user profile
#   XTS_ALLOCATOR_PROFILE_DIR - Profile directory (default: ~/.xts/config/allocators)
#   XTS_ALLOCATOR_INSTANCE - Instance/profile key (default: $XTS_ALIAS_NAME or 'allocator')
#   XTS_ALLOCATOR_PROFILE - Explicit profile path override
#   XTS_ALIAS_NAME - Auto-set by xts_core when running via alias
#
# Duration Format:
#   30m  = 30 minutes
#   2h   = 2 hours
#   90   = 90 minutes (plain number)

brief: "Allocator box orchestration commands for XTS (search, allocate, state, test lifecycle)"
alias_name: "allocator"

# Command groups for organized display (user-facing vs test automation)
command_groups:
  user_commands:
    title: "User Commands"
    description: "Commands for human users"
    commands:
      - list
      - list_free
      - list_allocated
      - list_by_platform
      - list_targets
      - list_racks
      - search_boxes
      - search_by_platform
      - search_by_rack
      - search_by_tags
      - search_by_label
      - search_by_equipment
      - describe_box
      - alloc
      - alloc_by_id
      - alloc_by_platform
      - alloc_by_tags
      - alloc_by_target
      - release
      - release_me
      - borrow_box
      - return_borrow_box
      - help_commands
      - tutorial
      - guide
      - guide_quickstart
      - guide_server
      - guide_allocation
      - guide_search
      - guide_testing
      - guide_borrowing
      - guide_state
      - guide_authentication
      - manual
      - whoami
      - register
      - xts_allocator_register
  test_automation:
    title: "Test Automation"
    description: "Commands for test scripts and automation"
    commands:
      - status
      - report_heartbeat
      - start_test
      - heartbeat_test
      - heartbeat_device
      - active_test
      - list_active_tests
      - end_test
      - get_state
      - set_state
      - valid_states
      - box_heartbeat
      - annotate_box
      - label_box
      - set_slot_contents

# Shared formatter functions (reusable via {{function_name}} syntax)
functions:
  format_device_list:
    description: Format device list from slots array (list endpoints)
    command: |
      python3 -c "
      import sys, json
      data = json.load(sys.stdin)
      slots = data.get('slots', [])
      if not slots:
          print('\\033[93mNo devices found.\\033[0m')
          sys.exit(0)
      print(f'\\n\\033[1m\\033[96mDevice List ({len(slots)} devices):\\033[0m\\n')
      print('\\033[1m%-4s %-38s %-12s %-18s %-8s\\033[0m' % ('ID', 'Target', 'State', 'Labels', 'Eq#'))
      print('─' * 90)
      for s in slots:
          sid = str(s.get('slot_id', '?'))[:4]
          target = s.get('target_id') or f\"{s.get('platform', 'unknown')}@{s.get('rackName', '-')}/{s.get('slotName', '-')}\" 
          target = target[:38]
          state = s.get('state', 'unknown')
          labels = ','.join(s.get('labels') or s.get('tags') or [])[:18] or '-'
          equipment_count = len(s.get('slot_contents') or s.get('external_equipment') or [])
          sc = '\\033[92m' if state == 'free' else ('\\033[93m' if state == 'allocated' else '\\033[0m')
          print('\\033[96m%-4s\\033[0m %-38s %s%-12s\\033[0m %-18s %-8s' % (sid, target, sc, state, labels, equipment_count))
      print('\\n' + '─' * 90)
      print('\\033[2mUse xts allocator describe_box <id|target> for full box/rack-slot details\\033[0m')
      free = sum(1 for s in slots if s.get('state') == 'free')
      alloc = sum(1 for s in slots if s.get('state') == 'allocated')
      print(f'\\n\\033[1mSummary:\\033[0m \\033[92m{free} free\\033[0m, \\033[93m{alloc} allocated\\033[0m')
      "
  
  format_search_results:
    description: Format device list from results array (search endpoints)
    command: |
      python3 -c "
      import sys, json
      data = json.load(sys.stdin)
      results = data.get('results', [])
      if not results:
          print('\\033[93mNo devices found.\\033[0m')
          sys.exit(0)
      print(f'\\n\\033[1m\\033[96mDevice List ({len(results)} devices):\\033[0m\\n')
      print('\\033[1m%-4s %-38s %-12s %-18s %-8s\\033[0m' % ('ID', 'Target', 'State', 'Labels', 'Eq#'))
      print('─' * 90)
      for r in results:
          sid = str(r.get('id', '?'))[:4]
          target = r.get('target_id') or f\"{r.get('platform', 'unknown')}@{r.get('rack_name', '-')}/{r.get('slot_name', '-')}\" 
          target = target[:38]
          state = r.get('state', 'unknown')
          labels = ','.join(r.get('labels') or r.get('tags') or [])[:18] or '-'
          equipment_count = len(r.get('slot_contents') or r.get('external_equipment') or [])
          sc = '\\033[92m' if state == 'free' else ('\\033[93m' if state == 'allocated' else '\\033[0m')
          print('\\033[96m%-4s\\033[0m %-38s %s%-12s\\033[0m %-18s %-8s' % (sid, target, sc, state, labels, equipment_count))
      print('\\n' + '─' * 90)
      print('\\033[2mUse xts allocator describe_box <id|target> for full box/rack-slot details\\033[0m')
      free = sum(1 for r in results if r.get('state') == 'free')
      alloc = sum(1 for r in results if r.get('state') == 'allocated')
      print(f'\\n\\033[1mSummary:\\033[0m \\033[92m{free} free\\033[0m, \\033[93m{alloc} allocated\\033[0m')
      "
  
  format_rack_list:
    description: Format rack list
    command: |
      python3 -c "
      import sys, json
      data = json.load(sys.stdin)
      racks = data.get('racks', [])
      if not racks:
          print('\\033[93mNo racks found.\\033[0m')
          sys.exit(0)
      print(f'\\n\\033[1m\\033[96mRack List ({len(racks)} racks):\\033[0m\\n')
      print('\\033[1m%-20s %-25s %-20s %-10s\\033[0m' % ('Name', 'Location', 'Building', 'Devices'))
      print('─' * 80)
      for r in racks:
          name = r.get('name', 'Unknown')[:20]
          loc = r.get('location', '-')[:25]
          bld = r.get('building', '-')[:20]
          cnt = r.get('device_count', 0)
          print('\\033[96m%-20s\\033[0m %-25s %-20s %-10s' % (name, loc, bld, cnt))
      print()
      "

tutorial:
  description: |
    Show allocator onboarding and common workflows

    Usage: xts allocator tutorial
  command: |
    ALLOCATOR_INSTANCE="${XTS_ALLOCATOR_INSTANCE:-${XTS_ALIAS_NAME:-allocator}}"
    PROFILE_DIR="${XTS_ALLOCATOR_PROFILE_DIR:-$HOME/.xts/config/allocators}"
    PROFILE_PATH="${XTS_ALLOCATOR_PROFILE:-${PROFILE_DIR}/${ALLOCATOR_INSTANCE}.env}"
    SERVER="${XTS_ALLOCATOR_SERVER:-http://localhost:5000}"
    echo ""
    echo "\033[1m\033[96mXTS Allocator Tutorial\033[0m"
    echo "==============================================="
    echo ""
    echo "\033[1m1) Connect to server alias\033[0m"
    echo "   xts alias add allocator ${SERVER}/xts_allocator.xts"
    echo ""
    echo "\033[1m2) Register local user profile (interactive)\033[0m"
    echo "   xts allocator register"
    echo "   xts allocator xts_allocator_register"
    echo "   - pulls git user.name / user.email defaults if available"
    echo "   - stores per-instance profile in ${PROFILE_PATH}"
    echo ""
    echo "\033[1m3) Verify connectivity\033[0m"
    echo "   xts allocator status"
    echo "   xts allocator whoami"
    echo ""
    echo "\033[1m4) Find and allocate a box\033[0m"
    echo "   xts allocator list llama --free"
    echo "   xts allocator alloc llama 2h"
    echo "   xts allocator alloc Cisco@TestRack1/Slot1 2h"
    echo ""
    echo "\033[1m5) Manage state and test lifecycle\033[0m"
    echo "   xts allocator get_state 5"
    echo "   xts allocator set_state 5 maintenance"
    echo "   xts allocator start_test 5 smoke_boot 20"
    echo "   xts allocator box_heartbeat 5"
    echo ""
    echo "\033[1m6) Borrow and return desk boxes\033[0m"
    echo "   xts allocator borrow_box 5 2h \"owner away\""
    echo "   xts allocator return_borrow_box 5"
    echo ""

guide:
  description: |
    Interactive learning system for XTS Allocator with topic navigation.
    
    Usage: xts allocator guide
    
    Topics (use guide_<topic> to jump directly):
      guide_quickstart       - Get started in 5 minutes
      guide_server           - Server setup and connectivity
      guide_allocation       - Allocating and releasing devices
      guide_search           - Finding devices by criteria
      guide_testing          - Test lifecycle management
      guide_borrowing        - Borrowing desk boxes temporarily
      guide_state            - Device state management
      guide_authentication   - JWT tokens and permissions
    
    Examples:
      xts allocator guide                    # Show all topics
      xts allocator guide_allocation         # Learn about allocation
      xts allocator guide_search             # Learn about searching
  command: |
    show_topics() {
      echo ""
      echo "\033[1m\033[96m📚 XTS Allocator Learning System\033[0m"
      echo "═══════════════════════════════════════════════════════════"
      echo ""
      echo "\033[1m\033[93mAvailable Topics:\033[0m"
      echo ""
      echo "  \033[1m\033[92mquickstart\033[0m    - Get started in 5 minutes"
      echo "  \033[1m\033[92mserver\033[0m        - Server setup and connectivity"
      echo "  \033[1m\033[92malloc\033[0m (allocation) - Allocating and releasing devices"
      echo "  \033[1m\033[92msearch\033[0m        - Finding devices by criteria"
      echo "  \033[1m\033[92mtesting\033[0m       - Test lifecycle management"
      echo "  \033[1m\033[92mborrowing\033[0m     - Borrowing desk boxes temporarily"
      echo "  \033[1m\033[92mstate\033[0m         - Device state management"
      echo "  \033[1m\033[92mauth\033[0m (authentication) - JWT tokens and permissions"
      echo ""
      echo "\033[1m\033[93mQuick Commands:\033[0m"
      echo "  xts allocator guide_quickstart     # 5-minute quick start"
      echo "  xts allocator guide_allocation     # Deep dive on allocations"
      echo "  xts allocator manual               # Full reference manual"
      echo ""
    }
    
    show_topics

guide_quickstart:
  description: "Quick start guide - Get up and running in 5 minutes"
  command: |
    echo ""
    echo "\033[1m\033[96m🚀 Quick Start - 5 Minute Guide\033[0m"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "\033[1m\033[93mStep 1: Add Server Alias\033[0m"
    echo "  xts alias add allocator http://your-server:5000/allocator.xts"
    echo ""
    echo "\033[1m\033[93mStep 2: Register Your Profile\033[0m"
    echo "  xts allocator register"
    echo "  # Enter your email, name, and server URL"
    echo ""
    echo "\033[1m\033[93mStep 3: Verify Connection\033[0m"
    echo "  xts allocator status"
    echo "  xts allocator whoami"
    echo ""
    echo "\033[1m\033[93mStep 4: Find Available Devices\033[0m"
    echo "  xts allocator list --free                 # All free devices"
    echo "  xts allocator search_by_platform llama    # Find llama devices"
    echo ""
    echo "\033[1m\033[93mStep 5: Allocate a Device\033[0m"
    echo "  xts allocator alloc llama 2h              # Platform + duration"
    echo "  xts allocator alloc_by_id 5 2h            # By device ID"
    echo ""
    echo "\033[1m\033[93mStep 6: Use Your Device\033[0m"
    echo "  xts allocator describe_box 5              # Get connection details"
    echo "  # SSH, ADB, or HTTP to your device..."
    echo ""
    echo "\033[1m\033[93mStep 7: Release When Done\033[0m"
    echo "  xts allocator release your.email@company.com 5"
    echo "  xts allocator release_me                   # Release all yours"
    echo ""
    echo "\033[1m\033[92m✓ You're ready to go!\033[0m"
    echo ""
    echo "\033[1mNext Steps:\033[0m"
    echo "  xts allocator guide_allocation    # Learn more about allocations"
    echo "  xts allocator guide_search        # Advanced device searching"
    echo "  xts allocator guide_testing       # Test lifecycle management"
    echo ""

guide_server:
  description: "Learn about server setup, connectivity, and configuration"
  command: |
    echo ""
    echo "\033[1m\033[96m🌐 Server Setup & Connectivity\033[0m"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "\033[1m\033[93m1. Adding a Server\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mBasic:\033[0m"
    echo "    xts alias add allocator http://server:5000/allocator.xts"
    echo ""
    echo "  \033[1mWith proxy (corporate environment):\033[0m"
    echo "    xts proxy add corp proxy.company.com:8080 --username you"
    echo "    xts alias add allocator http://server:5000/allocator.xts --proxy corp"
    echo ""
    echo "  \033[1mMultiple environments:\033[0m"
    echo "    xts alias add alloc_london http://london:5000/allocator.xts"
    echo "    xts alias add alloc_austin http://austin:5000/allocator.xts"
    echo ""
    echo "\033[1m\033[93m2. Server Configuration\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mEnvironment Variables:\033[0m"
    echo "    export XTS_ALLOCATOR_SERVER=http://server:5000"
    echo "    export XTS_ALLOCATOR_TOKEN=your-jwt-token"
    echo "    export XTS_ALLOCATOR_ADMIN_TOKEN=admin-jwt-token"
    echo ""
    echo "  \033[1mPer-instance profiles:\033[0m"
    echo "    ~/.xts/config/allocators/allocator.env     # Default"
    echo "    ~/.xts/config/allocators/london.env        # London lab"
    echo "    ~/.xts/config/allocators/austin.env        # Austin lab"
    echo ""
    echo "\033[1m\033[93m3. Testing Connectivity\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mBasic health check:\033[0m"
    echo "    xts allocator status"
    echo ""
    echo "  \033[1mVerify your identity:\033[0m"
    echo "    xts allocator whoami"
    echo ""
    echo "  \033[1mTest device listing:\033[0m"
    echo "    xts allocator list"
    echo ""
    echo "\033[1m\033[93m4. Troubleshooting\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mCannot connect:\033[0m"
    echo "    • Check server URL is correct"
    echo "    • Verify firewall/proxy settings"
    echo "    • Test with: curl http://server:5000/health"
    echo ""
    echo "  \033[1mAuthentication errors:\033[0m"
    echo "    • Ensure XTS_ALLOCATOR_TOKEN is set"
    echo "    • Token may be expired - request new one"
    echo "    • Check: xts allocator whoami"
    echo ""
    echo "  \033[1mProxy issues:\033[0m"
    echo "    • List proxies: xts proxy list"
    echo "    • Test proxy: curl --proxy proxy:8080 http://server:5000/health"
    echo "    • Update alias to use proxy: --proxy name"
    echo ""
    echo "\033[1mMore Topics:\033[0m"
    echo "  xts allocator guide_authentication    # JWT tokens & permissions"
    echo "  xts allocator guide_allocation        # Using the allocator"
    echo ""

guide_allocation:
  description: "Learn about allocating and releasing devices"
  command: |
    echo ""
    echo "\033[1m\033[96m📦 Device Allocation & Release\033[0m"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "\033[1m\033[93m1. Allocation Methods\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mBy Platform (simplest):\033[0m"
    echo "    xts allocator alloc llama 2h"
    echo "    xts allocator alloc_by_platform llama 2h"
    echo ""
    echo "  \033[1mBy Device ID:\033[0m"
    echo "    xts allocator alloc_by_id 5 2h"
    echo "    xts allocator alloc_by_id 5 90         # 90 minutes"
    echo ""
    echo "  \033[1mBy Tags:\033[0m"
    echo "    xts allocator alloc_by_tags 4k,hdr 2h"
    echo "    xts allocator alloc_by_tags wifi6 30m"
    echo ""
    echo "  \033[1mBy Target (rack + slot):\033[0m"
    echo "    xts allocator alloc_by_target TestRack1 Slot5 2h"
    echo "    xts allocator alloc Cisco@TestRack1/Slot5 2h"
    echo ""
    echo "\033[1m\033[93m2. Duration Formats\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  30m     = 30 minutes"
    echo "  2h      = 2 hours"
    echo "  90      = 90 minutes (plain number)"
    echo "  1.5h    = 90 minutes"
    echo ""
    echo "  \033[1mExamples:\033[0m"
    echo "    xts allocator alloc llama 30m         # Quick test"  
    echo "    xts allocator alloc llama 2h          # Standard session"
    echo "    xts allocator alloc llama 480         # 8 hours"
    echo ""
    echo "\033[1m\033[93m3. Checking Allocations\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mYour allocations:\033[0m"
    echo "    xts allocator list_allocated"
    echo ""
    echo "  \033[1mAll allocations:\033[0m"
    echo "    xts allocator list"
    echo ""
    echo "  \033[1mDevice details:\033[0m"
    echo "    xts allocator describe_box 5"
    echo ""
    echo "\033[1m\033[93m4. Releasing Devices\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mRelease specific device:\033[0m"
    echo "    xts allocator release your.email@company.com 5"
    echo ""
    echo "  \033[1mRelease all your devices:\033[0m"
    echo "    xts allocator release_me"
    echo ""
    echo "  \033[1mAuto-release:\033[0m"
    echo "    • Devices auto-release when duration expires"
    echo "    • Active tests extend the allocation automatically"
    echo "    • Manual release returns device to pool immediately"
    echo ""
    echo "\033[1m\033[93m5. Allocation States\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  free        → allocated    (when you allocate)"
    echo "  allocated   → testing      (when test starts)"
    echo "  testing     → allocated    (when test ends)"
    echo "  allocated   → resetting    (on expiry/release)"
    echo "  resetting   → free         (after cleanup)"
    echo ""
    echo "\033[1m\033[93m6. Tips & Best Practices\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  ✓ Allocate for expected duration + buffer"
    echo "  ✓ Release when done to help others"
    echo "  ✓ Use test heartbeats to extend automatically"
    echo "  ✓ Check device details before connecting"
    echo "  ✗ Don't allocate longer than needed"
    echo "  ✗ Don't hoard devices you're not using"
    echo ""
    echo "\033[1mMore Topics:\033[0m"
    echo "  xts allocator guide_search     # Finding the right device"
    echo "  xts allocator guide_testing    # Test lifecycle"
    echo "  xts allocator guide_state      # State management"
    echo ""

guide_search:
  description: "Learn about finding devices using various search criteria"
  command: |
    echo ""
    echo "\033[1m\033[96m🔍 Device Search & Discovery\033[0m"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "\033[1m\033[93m1. Basic Listing\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mAll devices:\033[0m"
    echo "    xts allocator list"
    echo ""
    echo "  \033[1mOnly free devices:\033[0m"
    echo "    xts allocator list_free"
    echo "    xts allocator list --free"
    echo ""
    echo "  \033[1mAllocated devices:\033[0m"
    echo "    xts allocator list_allocated"
    echo ""
    echo "\033[1m\033[93m2. Search by Platform\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator search_by_platform llama"
    echo "  xts allocator search_by_platform llama --free"
    echo "  xts allocator list_by_platform llama"
    echo "  xts allocator list llama                    # Short form"
    echo ""
    echo "\033[1m\033[93m3. Search by Rack\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator search_by_rack TestRack1"
    echo "  xts allocator list_racks                    # Show all racks"
    echo ""
    echo "\033[1m\033[93m4. Search by Tags\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mSingle tag:\033[0m"
    echo "    xts allocator search_by_tags 4k"
    echo "    xts allocator search_by_tags wifi6 --free"
    echo ""
    echo "  \033[1mMultiple tags (AND logic):\033[0m"
    echo "    xts allocator search_by_tags 4k,hdr"
    echo "    xts allocator search_by_tags wifi6,bluetooth"
    echo ""
    echo "\033[1m\033[93m5. Search by Label\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator search_by_label \"Dev Box 1\""
    echo "  xts allocator search_by_label \"Test\""         # Partial match"
    echo ""
    echo "\033[1m\033[93m6. Search by Equipment\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator search_by_equipment analyzer"
    echo "  xts allocator search_by_equipment camera"
    echo ""
    echo "\033[1m\033[93m7. Advanced Search\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mGeneric search (checks multiple fields):\033[0m"
    echo "    xts allocator search_boxes llama"
    echo "    xts allocator search_boxes \"London\""
    echo "    xts allocator search_boxes 4k --free"
    echo ""
    echo "\033[1m\033[93m8. Device Details\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator describe_box 5"
    echo "  xts allocator describe_box TestRack1/Slot3"
    echo ""
    echo "  \033[1mShows:\033[0m"
    echo "    • Platform and model information"
    echo "    • Network details (IP, MAC, ports)"
    echo "    • Connection URIs (SSH, ADB, HTTP)"
    echo "    • Allocation status and owner"
    echo "    • Tags and capabilities"
    echo "    • External equipment available"
    echo ""
    echo "\033[1m\033[93m9. Search Tips\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  ✓ Use --free to find available devices"
    echo "  ✓ Search by platform for specific device types"
    echo "  ✓ Use tags to find devices with specific capabilities"
    echo "  ✓ Check describe_box for connection details"
    echo "  ✓ Combine platform + --free for quick allocation"
    echo ""
    echo "\033[1mMore Topics:\033[0m"
    echo "  xts allocator guide_allocation    # How to allocate found devices"
    echo "  xts allocator list_targets        # Show all available platforms"
    echo ""

guide_testing:
  description: "Learn about test lifecycle management and automation"
  command: |
    echo ""
    echo "\033[1m\033[96m🧪 Test Lifecycle Management\033[0m"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "\033[1m\033[93m1. Test Lifecycle Overview\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  1. \033[1mAllocate\033[0m device      → state: \033[92mallocated\033[0m"
    echo "  2. \033[1mStart\033[0m test           → state: \033[93mtesting\033[0m"
    echo "  3. \033[1mSend heartbeats\033[0m      → extends allocation"
    echo "  4. \033[1mEnd\033[0m test             → state: \033[92mallocated\033[0m"
    echo "  5. \033[1mRelease\033[0m device       → state: \033[96mresetting\033[0m → \033[92mfree\033[0m"
    echo ""
    echo "\033[1m\033[93m2. Starting a Test\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator start_test <device_id> <test_name> <expected_duration>"
    echo ""
    echo "  \033[1mExamples:\033[0m"
    echo "    xts allocator start_test 5 \"smoke_boot\" 20"
    echo "    xts allocator start_test 5 \"regression_suite\" 120"
    echo ""
    echo "  \033[1mParameters:\033[0m"
    echo "    device_id          - Device ID number"
    echo "    test_name          - Descriptive test name"
    echo "    expected_duration  - Minutes (used to extend allocation)"
    echo ""
    echo "\033[1m\033[93m3. Test Heartbeats\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mWhy heartbeats?\033[0m"
    echo "    • Proves test is still running"
    echo "    • Prevents timeout/cleanup of active tests"
    echo "    • Extends allocation automatically"
    echo ""
    echo "  \033[1mSending heartbeats:\033[0m"
    echo "    xts allocator heartbeat_test <test_id>"
    echo "    xts allocator box_heartbeat <device_id>"
    echo ""
    echo "  \033[1mHeartbeat frequency:\033[0m"
    echo "    • Send every 60-120 seconds"
    echo "    • Timeouts occur after 5 minutes of silence"
    echo "    • Use cron/timer in test framework"
    echo ""
    echo "\033[1m\033[93m4. Ending a Test\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator end_test <test_id> [result] [notes]"
    echo ""
    echo "  \033[1mExamples:\033[0m"
    echo "    xts allocator end_test 42 pass"
    echo "    xts allocator end_test 42 fail \"Boot timeout\""
    echo "    xts allocator end_test 42 skip \"Device offline\""
    echo ""
    echo "\033[1m\033[93m5. Monitoring Active Tests\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mList all active tests:\033[0m"
    echo "    xts allocator list_active_tests"
    echo ""
    echo "  \033[1mCheck specific test:\033[0m"
    echo "    xts allocator active_test <device_id>"
    echo ""
    echo "\033[1m\033[93m6. Test Automation Integration\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mExample test script:\033[0m"
    echo "    #!/bin/bash"
    echo "    DEVICE_ID=\$1"
    echo "    TEST_NAME=\"my_test_suite\""
    echo "    "
    echo "    # Start test"
    echo "    TEST_ID=\$(xts allocator start_test \$DEVICE_ID \"\$TEST_NAME\" 60 | jq -r '.test_execution_id')"
    echo "    "
    echo "    # Background heartbeat"
    echo "    (while true; do"
    echo "      xts allocator heartbeat_test \$TEST_ID"
    echo "      sleep 90"
    echo "    done) &"
    echo "    HEARTBEAT_PID=\$!"
    echo "    "
    echo "    # Run your tests..."
    echo "    ./run_tests.sh"
    echo "    RESULT=\$?"
    echo "    "
    echo "    # Stop heartbeat"
    echo "    kill \$HEARTBEAT_PID"
    echo "    "
    echo "    # End test"
    echo "    if [ \$RESULT -eq 0 ]; then"
    echo "      xts allocator end_test \$TEST_ID pass"
    echo "    else"
    echo "      xts allocator end_test \$TEST_ID fail"
    echo "    fi"
    echo ""
    echo "\033[1m\033[93m7. Best Practices\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  ✓ Always send heartbeats during long tests"
    echo "  ✓ End tests explicitly (don't rely on timeout)"
    echo "  ✓ Include clear test names for debugging"
    echo "  ✓ Use expected_duration to pre-extend allocation"
    echo "  ✓ Calculate duration as actual_time + 15min buffer"
    echo "  ✗ Don't forget to end tests when done"
    echo "  ✗ Don't let tests timeout without cleanup"
    echo ""
    echo "\033[1mMore Topics:\033[0m"
    echo "  xts allocator guide_allocation    # How to allocate devices"
    echo "  xts allocator guide_state         # Device state management"
    echo ""

guide_borrowing:
  description: "Learn about temporarily borrowing desk boxes from other users"
  command: |
    echo ""
    echo "\033[1m\033[96m🤝 Borrowing Desk Boxes\033[0m"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "\033[1m\033[93m1. What is Borrowing?\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  Borrowing allows you to temporarily use a device that's"
    echo "  permanently allocated to another user (desk box, personal"
    echo "  device) while they're away or not using it."
    echo ""
    echo "  \033[1mKey Points:\033[0m"
    echo "    • Only for permanently allocated devices"
    echo "    • Requires a specific duration and reason"
    echo "    • Original owner can see who borrowed it"
    echo "    • Must return when done or duration expires"
    echo ""
    echo "\033[1m\033[93m2. Borrowing a Device\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator borrow_box <device_id> <duration> <reason>"
    echo ""
    echo "  \033[1mExamples:\033[0m"
    echo "    xts allocator borrow_box 5 2h \"owner on vacation\""
    echo "    xts allocator borrow_box 12 30m \"quick compatibility test\""
    echo "    xts allocator borrow_box 8 4h \"owner in meeting\""
    echo ""
    echo "\033[1m\033[93m3. Requirements\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  ✓ Device must be permanently allocated"
    echo "  ✓ Device must be in 'allocated' state"
    echo "  ✓ Device must not be in active use (testing)"
    echo "  ✓ Must provide valid reason"
    echo "  ✓ Duration must be reasonable (typically max 8h)"
    echo ""
    echo "\033[1m\033[93m4. Returning a Borrowed Device\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator return_borrow_box <device_id>"
    echo ""
    echo "  \033[1mExamples:\033[0m"
    echo "    xts allocator return_borrow_box 5"
    echo ""
    echo "  \033[1mAuto-return:\033[0m"
    echo "    • Device returns automatically when duration expires"
    echo "    • Manual return is recommended when done early"
    echo "    • State returns to 'allocated' with original owner"
    echo ""
    echo "\033[1m\033[93m5. Checking Borrowed Status\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mDevice details:\033[0m"
    echo "    xts allocator describe_box 5"
    echo ""
    echo "  \033[1mShows:\033[0m"
    echo "    • Original owner"
    echo "    • Current borrower (if borrowed)"
    echo "    • Borrow reason"
    echo "    • Borrow expiry time"
    echo ""
    echo "\033[1m\033[93m6. Borrowing vs Regular Allocation\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mRegular Allocation:\033[0m"
    echo "    • Takes device from free pool"
    echo "    • Device becomes yours for duration"
    echo "    • Released back to free pool"
    echo ""
    echo "  \033[1mBorrowing:\033[0m"
    echo "    • Takes device from permanent owner"
    echo "    • Device is temporarily yours"
    echo "    • Returns to original owner"
    echo ""
    echo "\033[1m\033[93m7. Etiquette & Best Practices\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  ✓ Ask owner permission when possible"
    echo "  ✓ Provide clear reason for borrowing"
    echo "  ✓ Return as soon as you're done"
    echo "  ✓ Respect device configuration/state"
    echo "  ✓ Don't borrow if free devices available"
    echo "  ✗ Don't borrow without good reason"
    echo "  ✗ Don't change permanent settings"
    echo "  ✗ Don't borrow for longer than needed"
    echo ""
    echo "\033[1m\033[93m8. Common Use Cases\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  • Owner on vacation/leave"
    echo "  • Quick compatibility test on specific hardware"
    echo "  • Owner in meeting/away from desk"
    echo "  • Reproducing bug on specific device"
    echo "  • Emergency testing when no free devices"
    echo ""
    echo "\033[1mMore Topics:\033[0m"
    echo "  xts allocator guide_allocation    # Regular allocations"
    echo "  xts allocator guide_state         # Device states"
    echo ""

guide_state:
  description: "Learn about device state management and transitions"
  command: |
    echo ""
    echo "\033[1m\033[96m⚙️  Device State Management\033[0m"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "\033[1m\033[93m1. Device States\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[92mfree\033[0m          - Available for allocation"
    echo "  \033[93mallocated\033[0m     - Allocated to a user, not testing"
    echo "  \033[93mtesting\033[0m       - Actively running tests"
    echo "  \033[91mbusy\033[0m          - Temporarily unavailable"
    echo "  \033[96mresetting\033[0m     - Being cleaned/reset"
    echo "  \033[95mmaintenance\033[0m   - Under maintenance, offline"
    echo "  \033[90moffline\033[0m       - Disconnected or unreachable"
    echo ""
    echo "\033[1m\033[93m2. State Transitions\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mNormal workflow:\033[0m"
    echo "    free → allocated → testing → allocated → resetting → free"
    echo ""
    echo "  \033[1mMaintenance:\033[0m"
    echo "    any_state → maintenance → free"
    echo ""
    echo "  \033[1mOffline handling:\033[0m"
    echo "    any_state → offline → maintenance → free"
    echo ""
    echo "\033[1m\033[93m3. Getting Device State\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator get_state <device_id>"
    echo ""
    echo "  \033[1mExamples:\033[0m"
    echo "    xts allocator get_state 5"
    echo "    xts allocator describe_box 5          # Includes state"
    echo ""
    echo "\033[1m\033[93m4. Manually Changing State\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator set_state <device_id> <new_state> [reason]"
    echo ""
    echo "  \033[1mExamples:\033[0m"
    echo "    xts allocator set_state 5 maintenance \"Hardware upgrade\""
    echo "    xts allocator set_state 5 offline \"Network issue\""
    echo "    xts allocator set_state 5 free \"Manual reset complete\""
    echo ""
    echo "  \033[1mNote:\033[0m Requires admin token (XTS_ALLOCATOR_ADMIN_TOKEN)"
    echo ""
    echo "\033[1m\033[93m5. Valid State Transitions\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mShow allowed transitions for a device:\033[0m"
    echo "    xts allocator valid_states <device_id>"
    echo ""
    echo "  \033[1mCommon transitions:\033[0m"
    echo "    free        → allocated, maintenance, offline"
    echo "    allocated   → testing, resetting, maintenance, offline"
    echo "    testing     → allocated, resetting, maintenance, offline"
    echo "    maintenance → free"
    echo "    offline     → maintenance"
    echo ""
    echo "\033[1m\033[93m6. State Meanings & Use Cases\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1m\033[92mfree:\033[0m"
    echo "    • Device ready for allocation"
    echo "    • Clean state, no active users"
    echo "    • Shows in search results"
    echo ""
    echo "  \033[1m\033[93mallocated:\033[0m"
    echo "    • Reserved for specific user"
    echo "    • Not actively testing"
    echo "    • Can start tests or interactive use"
    echo ""
    echo "  \033[1m\033[93mtesting:\033[0m"
    echo "    • Test execution in progress"
    echo "    • Heartbeats expected"
    echo "    • Auto-extends allocation"
    echo ""
    echo "  \033[1m\033[91mbusy:\033[0m"
    echo "    • Temporarily unavailable"
    echo "    • Rebooting or brief operation"
    echo "    • Short-term state"
    echo ""
    echo "  \033[1m\033[96mresetting:\033[0m"
    echo "    • Cleanup in progress"
    echo "    • Factory reset, wiping data"
    echo "    • Transition to free when done"
    echo ""
    echo "  \033[1m\033[95mmaintenance:\033[0m"
    echo "    • Manual intervention needed"
    echo "    • Hardware repair/upgrade"  
    echo "    • Software issues"
    echo "    • Hidden from normal searches"
    echo ""
    echo "  \033[1m\033[90moffline:\033[0m"
    echo "    • Network disconnected"
    echo "    • Power issue"
    echo "    • Hardware failure"
    echo "    • Needs investigation"
    echo ""
    echo "\033[1m\033[93m7. Automated State Changes\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  • \033[1mAllocation expiry:\033[0m allocated → resetting"
    echo "  • \033[1mTest start:\033[0m allocated → testing"
    echo "  • \033[1mTest end:\033[0m testing → allocated"
    echo "  • \033[1mTest timeout:\033[0m testing → resetting"
    echo "  • \033[1mRelease:\033[0m allocated → resetting"
    echo "  • \033[1mReset complete:\033[0m resetting → free"
    echo ""
    echo "\033[1m\033[93m8. Best Practices\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  ✓ Use maintenance for planned work"
    echo "  ✓ Use offline for connectivity issues"
    echo "  ✓ Add reasons when changing states"
    echo "  ✓ Return to free when maintenance done"
    echo "  ✓ Let automation handle normal flow"
    echo "  ✗ Don't manually change during normal operation"
    echo "  ✗ Don't leave devices in maintenance unnecessarily"
    echo ""
    echo "\033[1mMore Topics:\033[0m"
    echo "  xts allocator guide_testing       # Test lifecycle"
    echo "  xts allocator guide_allocation    # Allocation workflow"
    echo ""

guide_authentication:
  description: "Learn about JWT tokens and permissions"
  command: |
    echo ""
    echo "\033[1m\033[96m🔐 Authentication & Permissions\033[0m"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "\033[1m\033[93m1. JWT Token Overview\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  XTS Allocator uses JWT (JSON Web Tokens) for authentication."
    echo "  Tokens contain your email, role, and expiration time."
    echo ""
    echo "  \033[1mRoles:\033[0m"
    echo "    • \033[92mreadonly\033[0m  - View only, no modifications"
    echo "    • \033[93mengineer\033[0m  - Standard operations (allocate, test)"
    echo "    • \033[91madmin\033[0m     - Full access (state changes, force operations)"
    echo ""
    echo "\033[1m\033[93m2. Setting Up Tokens\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mEnvironment variables:\033[0m"
    echo "    export XTS_ALLOCATOR_TOKEN=\"your-engineer-or-admin-token\""
    echo "    export XTS_ALLOCATOR_ADMIN_TOKEN=\"your-admin-token\""
    echo ""
    echo "  \033[1mIn profile (recommended):\033[0m"
    echo "    xts allocator register              # Interactive setup"
    echo "    # Then manually add tokens to:"
    echo "    ~/.xts/config/allocators/allocator.env"
    echo ""
    echo "  \033[1mExample profile:\033[0m"
    echo "    export XTS_ALLOCATOR_TOKEN='eyJ...'"
    echo "    export XTS_ALLOCATOR_ADMIN_TOKEN='eyJ...'"
    echo ""
    echo "\033[1m\033[93m3. Getting Tokens\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  Contact your allocator server administrator to:"
    echo "    1. Create user account"
    echo "    2. Assign appropriate role"
    echo "    3. Generate JWT token"
    echo ""
    echo "  \033[1mToken generation (admin only):\033[0m"
    echo "    POST /auth/token"
    echo "    {\"email\": \"user@company.com\", \"role\": \"engineer\"}"
    echo ""
    echo "\033[1m\033[93m4. Permission Levels\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1m\033[92mReadonly:\033[0m"
    echo "    ✓ List devices"
    echo "    ✓ Search devices"
    echo "    ✓ View device details"
    echo "    ✓ Check allocations"
    echo "    ✓ View test executions"
    echo "    ✗ Allocate devices"
    echo "    ✗ Start tests"
    echo "    ✗ Change states"
    echo ""
    echo "  \033[1m\033[93mEngineer:\033[0m"
    echo "    ✓ All readonly permissions"
    echo "    ✓ Allocate/release devices"
    echo "    ✓ Start/end tests"
    echo "    ✓ Send heartbeats"
    echo "    ✓ Borrow boxes"
    echo "    ✗ Change device states"
    echo "    ✗ Force deallocations"
    echo ""
    echo "  \033[1m\033[91mAdmin:\033[0m"
    echo "    ✓ All engineer permissions"
    echo "    ✓ Change device states"
    echo "    ✓ Force deallocations"
    echo "    ✓ Set maintenance mode"
    echo "    ✓ Mark devices offline"
    echo "    ✓ View audit logs"
    echo ""
    echo "\033[1m\033[93m5. Token Expiration\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  \033[1mDefault lifetimes:\033[0m"
    echo "    • Access token:  8 hours"
    echo "    • Refresh token: 30 days"
    echo ""
    echo "  \033[1mRefreshing tokens:\033[0m"
    echo "    POST /auth/refresh"
    echo "    {\"refresh_token\": \"your-refresh-token\"}"
    echo ""
    echo "  \033[1mExpired token symptoms:\033[0m"
    echo "    • 401 Unauthorized errors"
    echo "    • \"Token expired\" messages"
    echo "    • Authentication failures"
    echo ""
    echo "\033[1m\033[93m6. Checking Your Identity\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  xts allocator whoami"
    echo ""
    echo "  \033[1mShows:\033[0m"
    echo "    • Your email"
    echo "    • Your role (from token)"
    echo "    • Server URL"
    echo "    • Profile location"
    echo ""
    echo "\033[1m\033[93m7. Rate Limiting\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  API requests are rate-limited per user:"
    echo "    • Standard endpoints: 30 requests/minute"
    echo "    • Auth endpoints: 5 requests/minute"
    echo ""
    echo "  \033[1mExceeding limits:\033[0m"
    echo "    • 429 Too Many Requests"
    echo "    • Retry after waiting"
    echo ""
    echo "\033[1m\033[93m8. Security Best Practices\033[0m"
    echo "───────────────────────────────────────────────────────────"
    echo "  ✓ Store tokens in profile files (chmod 600)"
    echo "  ✓ Never commit tokens to git"
    echo "  ✓ Use separate admin token for privileged ops"
    echo "  ✓ Refresh tokens before expiry"
    echo "  ✓ Request new tokens when compromised"
    echo "  ✗ Don't share tokens with others"
    echo "  ✗ Don't use admin tokens for routine work"
    echo "  ✗ Don't store tokens in scripts (use env vars)"
    echo ""
    echo "\033[1mMore Topics:\033[0m"
    echo "  xts allocator guide_server        # Server setup"
    echo "  xts allocator guide_state         # State management (admin)"
    echo ""

manual:
  description: |
    Complete reference manual for XTS Allocator.
    Comprehensive documentation of all features and commands.
    
    Usage: xts allocator manual [section]
    
    Sections:
      overview        - System overview and architecture
      commands        - Complete command reference
      api             - REST API documentation
      states          - Device state machine
      workflows       - Common workflows and patterns
      troubleshooting - Problem solving guide
  command: |
    SECTION="${1:-}"
    
    if [ -z "$SECTION" ]; then
      echo ""
      echo "\033[1m\033[96m📖 XTS Allocator Reference Manual\033[0m"
      echo "═══════════════════════════════════════════════════════════"
      echo ""
      echo "\033[1m\033[93m📚 Manual Sections:\033[0m"
      echo ""
      echo "  \033[1moverview\033[0m        - System overview and architecture"
      echo "  \033[1mcommands\033[0m        - Complete command reference"
      echo "  \033[1mapi\033[0m             - REST API documentation"
      echo "  \033[1mstates\033[0m          - Device state machine"  
      echo "  \033[1mworkflows\033[0m       - Common workflows and patterns"
      echo "  \033[1mtroubleshooting\033[0m - Problem solving guide"
      echo ""
      echo "\033[1m\033[93m🎓 Learning Paths:\033[0m"
      echo ""
      echo "  \033[1mNew Users:\033[0m"
      echo "    xts allocator guide_quickstart      # 5-minute guide"
      echo "    xts allocator guide_allocation      # How to allocate"
      echo "    xts allocator guide_search          # Finding devices"
      echo ""
      echo "  \033[1mAdministrators:\033[0m"
      echo "    xts allocator guide_server          # Server setup"
      echo "    xts allocator guide_state           # State management"
      echo "    xts allocator guide_authentication  # Tokens & roles"
      echo ""
      echo "  \033[1mTest Engineers:\033[0m"
      echo "    xts allocator guide_testing         # Test lifecycle"
      echo "    xts allocator guide_allocation      # Device allocation"
      echo "    xts allocator manual workflows      # Integration patterns"
      echo ""
      echo "\033[1m\033[93m📋 Quick Reference:\033[0m"
      echo "  xts allocator help_commands          # All commands"
      echo "  xts allocator --help                 # CLI help"
      echo "  xts allocator tutorial               # Classic tutorial"
      echo ""
      echo "\033[1m\033[93mUsage:\033[0m"
      echo "  xts allocator manual [section]       # Read specific section"
      echo "  xts allocator guide_<topic>          # Interactive learning"
      echo ""
      exit 0
    fi
    
    REPO_URL="https://github.com/rdkcentral/xts_allocator_server/blob/develop"

    case "$SECTION" in
      overview|intro|introduction)
        echo ""
        echo "\033[1m\033[96m📖 System Overview\033[0m"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "  XTS Allocator Server manages shared test device allocation"
        echo "  across racks, preventing conflicts and tracking state."
        echo ""
        echo "\033[1m\033[93mArchitecture:\033[0m"
        echo "  • Sanic async web framework (Python)"
        echo "  • SQLAlchemy ORM with SQLite (PostgreSQL-ready)"
        echo "  • JWT role-based auth (admin, engineer, readonly)"
        echo "  • .xts command file for CLI presentation layer"
        echo "  • Server returns JSON only — .xts handles formatting"
        echo ""
        echo "\033[1m\033[93mCore Concepts:\033[0m"
        echo "  • Devices live in racks, identified by platform + slot"
        echo "  • State machine: free → allocated → testing → allocated → free"
        echo "  • Temporary allocations auto-expire; permanent don't"
        echo "  • Federation: master aggregates devices from slave servers"
        echo "  • Audit log tracks all allocation and auth events"
        echo ""
        echo "\033[1m\033[93mKey Endpoints:\033[0m"
        echo "  /health              Health check + DB status"
        echo "  /metrics             Prometheus-compatible metrics"
        echo "  /list_slots          All devices with state"
        echo "  /allocate_slot       Allocate a device"
        echo "  /deallocate_slot     Release a device"
        echo "  /start_test          Begin test execution"
        echo "  /end_test            End test and record results"
        echo "  /openapi.json        OpenAPI 3.0 spec"
        echo ""
        echo "\033[1mFull docs:\033[0m $REPO_URL/README.md"
        echo ""
        ;;
      commands|command|cmd)
        xts allocator help_commands
        ;;
      api|rest|http)
        echo ""
        echo "\033[1m\033[96m📡 REST API Reference\033[0m"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "\033[1m\033[93mEndpoint Groups:\033[0m"
        echo ""
        echo "  \033[1mAllocation\033[0m (7 endpoints)"
        echo "    POST /allocate_slot           Allocate by ID, platform, or tags"
        echo "    POST /deallocate_slot          Release a device"
        echo "    POST /allocate_permanent       Permanent allocation"
        echo "    POST /report_status            Device status update"
        echo "    GET  /allocation_history       Allocation audit trail"
        echo "    POST /borrow_box               Temporarily borrow a device"
        echo "    POST /return_borrow_box        Return borrowed device"
        echo ""
        echo "  \033[1mDevice Management\033[0m (5 endpoints)"
        echo "    GET  /list_slots               List all devices"
        echo "    POST /add_slot                 Add a device"
        echo "    POST /update_slot              Update device details"
        echo "    POST /delete_slot              Remove a device"
        echo "    GET  /devices/search           Search with filters"
        echo ""
        echo "  \033[1mTest Lifecycle\033[0m (4 endpoints)"
        echo "    POST /start_test               Start test on allocated device"
        echo "    POST /test_heartbeat           Keep test alive"
        echo "    POST /end_test                 End test with results"
        echo "    GET  /test_executions          List test history"
        echo ""
        echo "  \033[1mRacks & Export\033[0m (4 endpoints)"
        echo "    GET  /racks                    List racks"
        echo "    GET  /export/raft_config       Export allocator YAML"
        echo "    GET  /export/python_raft_config  Export python_raft YAML"
        echo "    GET  /export/csv               Export CSV"
        echo ""
        echo "  \033[1mAuth & System\033[0m (6 endpoints)"
        echo "    POST /login                    Get JWT token"
        echo "    POST /refresh                  Refresh token"
        echo "    GET  /health                   Health check"
        echo "    GET  /metrics                  Prometheus metrics"
        echo "    GET  /metrics/prometheus        Prometheus text format"
        echo "    GET  /openapi.json             OpenAPI 3.0 spec"
        echo ""
        echo "  \033[1mFederation\033[0m (5 endpoints)"
        echo "    POST /register                 Register slave server"
        echo "    POST /heartbeat                Slave heartbeat"
        echo "    GET  /servers                  List servers"
        echo "    GET  /servers/<id>             Server details"
        echo "    GET  /servers/<id>/devices     Proxy device list"
        echo ""
        echo "\033[1m\033[93mCommon Headers:\033[0m"
        echo "  Authorization: Bearer <token>    Required for protected endpoints"
        echo "  Content-Type: application/json    Required for POST requests"
        echo ""
        echo "\033[1mFull endpoint docs:\033[0m $REPO_URL/design/endpoints.md"
        echo "\033[1mAuth details:\033[0m      $REPO_URL/AUTHENTICATION.md"
        echo ""
        ;;
      states|state|statemachine)
        xts allocator guide_state
        ;;
      workflows|workflow|patterns)
        echo ""
        echo "\033[1m\033[96m🔄 Common Workflows\033[0m"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "\033[1m\033[93m1. Basic Allocate → Test → Release\033[0m"
        echo "  xts allocator search_boxes --platform Cisco --free"
        echo "  xts allocator alloc_by_id you@company.com 5 2h"
        echo "  xts allocator start_test 5 my_test_suite/test_name"
        echo "  xts allocator end_test 5"
        echo "  xts allocator release you@company.com 5"
        echo ""
        echo "\033[1m\033[93m2. Quick Allocation by Platform\033[0m"
        echo "  xts allocator alloc_by_platform you@company.com Cisco 2h"
        echo "  # Server picks the first free Cisco device"
        echo ""
        echo "\033[1m\033[93m3. Borrow Someone's Desk Box\033[0m"
        echo "  xts allocator borrow_box you@company.com 5 30m"
        echo "  # Run your tests..."
        echo "  xts allocator return_borrow_box you@company.com 5"
        echo ""
        echo "\033[1m\033[93m4. Automation / CI Pipeline\033[0m"
        echo "  # Allocate with token auth"
        echo "  export XTS_ALLOCATOR_TOKEN=\$TOKEN"
        echo "  DEVICE=\$(xts allocator alloc_by_tags ci@pipeline.com \"network,router\" 4h)"
        echo "  xts allocator start_test \$DEVICE regression/full_suite"
        echo "  # Send heartbeats during long tests"
        echo "  xts allocator heartbeat_test \$DEVICE"
        echo "  xts allocator end_test \$DEVICE --status success"
        echo "  xts allocator release ci@pipeline.com \$DEVICE"
        echo ""
        echo "\033[1m\033[93m5. Export Config for python_raft\033[0m"
        echo "  curl \${XTS_ALLOCATOR_SERVER}/export/raft_config?owner_email=you@company.com"
        echo "  curl \${XTS_ALLOCATOR_SERVER}/export/python_raft_config?owner_email=you@company.com"
        echo ""
        echo "\033[1mDeep dive:\033[0m"
        echo "  xts allocator guide_allocation      # Allocation details"
        echo "  xts allocator guide_testing          # Test lifecycle"
        echo "  xts allocator guide_borrowing        # Borrowing workflow"
        echo ""
        ;;
      troubleshooting|troubleshoot|debug)
        echo ""
        echo "\033[1m\033[96m🔧 Troubleshooting\033[0m"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "\033[1m\033[93mConnection Issues\033[0m"
        echo "  \033[1mCan't reach server:\033[0m"
        echo "    xts allocator health               # Check server status"
        echo "    curl http://SERVER:5000/health      # Direct health check"
        echo "    # Check XTS_ALLOCATOR_SERVER env var is set"
        echo ""
        echo "  \033[1mProxy problems:\033[0m"
        echo "    xts proxy list                      # Show configured proxies"
        echo "    curl --proxy proxy:8080 http://SERVER:5000/health"
        echo ""
        echo "\033[1m\033[93mAuthentication Issues\033[0m"
        echo "  \033[1m401 Unauthorized:\033[0m"
        echo "    xts allocator whoami                # Check current identity"
        echo "    xts allocator register              # Re-register profile"
        echo "    # Check XTS_ALLOCATOR_TOKEN is set and not expired"
        echo ""
        echo "  \033[1m403 Forbidden:\033[0m"
        echo "    # Your role lacks permission for this action"
        echo "    # Engineer role needed for allocate/test, Admin for state changes"
        echo ""
        echo "\033[1m\033[93mAllocation Issues\033[0m"
        echo "  \033[1mNo free devices:\033[0m"
        echo "    xts allocator list_free              # Check what's available"
        echo "    xts allocator list_allocated          # See who has what"
        echo "    # Consider borrowing: xts allocator guide_borrowing"
        echo ""
        echo "  \033[1mAllocation expired mid-test:\033[0m"
        echo "    # Use expected_duration when starting tests"
        echo "    # Server auto-extends allocation for test duration + 15min"
        echo "    # Send heartbeats to keep long tests alive"
        echo ""
        echo "  \033[1mDevice stuck in wrong state:\033[0m"
        echo "    xts allocator describe_box 5         # Check current state"
        echo "    xts allocator set_state 5 free        # Admin: force state"
        echo "    # See state machine: xts allocator guide_state"
        echo ""
        echo "\033[1m\033[93mTest Issues\033[0m"
        echo "  \033[1mTest timed out / hung:\033[0m"
        echo "    xts allocator end_test 5 --status error"
        echo "    # Device returns to 'allocated' state"
        echo ""
        echo "  \033[1mHeartbeat missed:\033[0m"
        echo "    # Default timeout: 10 minutes"
        echo "    # Send heartbeats more frequently than the timeout"
        echo "    # Set custom timeout: --heartbeat_timeout 20"
        echo ""
        echo "\033[1m\033[93mServer Admin\033[0m"
        echo "  ./run.sh              # Start server"
        echo "  ./stop.sh             # Stop server"
        echo "  ./run.sh test         # Run test suite"
        echo "  ./run.sh clean        # Reset environment"
        echo ""
        echo "\033[1mMore help:\033[0m"
        echo "  xts allocator guide_server             # Server setup guide"
        echo "  xts allocator guide_authentication     # Auth deep dive"
        echo "  $REPO_URL/DATABASE_MANAGEMENT.md       # DB management"
        echo ""
        ;;
      *)
        echo "\033[1m\033[91mUnknown section:\033[0m $SECTION"
        echo ""
        echo "Available sections: overview, commands, api, states,"
        echo "                    workflows, troubleshooting"
        echo ""
        echo "Use: xts allocator manual"
        exit 1
        ;;
    esac
  params:
    passthrough: true

register:
  description: |
    Interactive user registration/profile setup for allocator commands.
    Pulls defaults from git config if available and asks before using them.

    Usage: xts allocator register [instance]

    Examples:
      xts allocator register
      xts allocator register lab_london
  command: |
    INSTANCE_ARG="${1:-}"
    ALLOCATOR_INSTANCE="${XTS_ALLOCATOR_INSTANCE:-${XTS_ALIAS_NAME:-allocator}}"
    if [ -n "$INSTANCE_ARG" ] && [ "${INSTANCE_ARG#-}" = "$INSTANCE_ARG" ]; then
      ALLOCATOR_INSTANCE="$INSTANCE_ARG"
    fi
    PROFILE_DIR="${XTS_ALLOCATOR_PROFILE_DIR:-$HOME/.xts/config/allocators}"
    PROFILE_PATH="${XTS_ALLOCATOR_PROFILE:-${PROFILE_DIR}/${ALLOCATOR_INSTANCE}.env}"
    SERVER_DEFAULT="${XTS_ALLOCATOR_SERVER:-http://localhost:5000}"

    if [ -f "$PROFILE_PATH" ]; then
      # shellcheck disable=SC1090
      . "$PROFILE_PATH"
      SERVER_DEFAULT="${XTS_ALLOCATOR_SERVER:-$SERVER_DEFAULT}"
    fi

    EXISTING_EMAIL="${XTS_ALLOCATOR_USER_EMAIL:-}"
    EXISTING_NAME="${XTS_ALLOCATOR_USER_NAME:-}"
    EXISTING_OFFICE="${XTS_ALLOCATOR_USER_OFFICE:-}"
    EXISTING_TEAM="${XTS_ALLOCATOR_USER_TEAM:-}"

    GIT_EMAIL="$(git config --get user.email 2>/dev/null || true)"
    GIT_NAME="$(git config --get user.name 2>/dev/null || true)"

    if [ -n "$GIT_EMAIL$GIT_NAME" ]; then
      echo ""
      echo "Found git config defaults:"
      [ -n "$GIT_NAME" ] && echo "  git user.name  = $GIT_NAME"
      [ -n "$GIT_EMAIL" ] && echo "  git user.email = $GIT_EMAIL"
      read -r -p "Use git defaults for name/email? [Y/n]: " USE_GIT_DEFAULTS
      case "$USE_GIT_DEFAULTS" in
        ""|y|Y|yes|YES)
          [ -z "$EXISTING_NAME" ] && EXISTING_NAME="$GIT_NAME"
          [ -z "$EXISTING_EMAIL" ] && EXISTING_EMAIL="$GIT_EMAIL"
          ;;
      esac
    fi

    echo ""
    read -r -p "User email [${EXISTING_EMAIL:-}]: " INPUT_EMAIL
    USER_EMAIL="${INPUT_EMAIL:-$EXISTING_EMAIL}"
    read -r -p "User name [${EXISTING_NAME:-}]: " INPUT_NAME
    USER_NAME="${INPUT_NAME:-$EXISTING_NAME}"
    read -r -p "Office/site [${EXISTING_OFFICE:-}]: " INPUT_OFFICE
    USER_OFFICE="${INPUT_OFFICE:-$EXISTING_OFFICE}"
    read -r -p "Team/project [${EXISTING_TEAM:-}]: " INPUT_TEAM
    USER_TEAM="${INPUT_TEAM:-$EXISTING_TEAM}"
    read -r -p "Allocator server URL [${SERVER_DEFAULT}]: " INPUT_SERVER
    USER_SERVER="${INPUT_SERVER:-$SERVER_DEFAULT}"

    if [ -z "$USER_EMAIL" ]; then
      echo "Error: user email is required."
      exit 1
    fi
    if ! printf '%s' "$USER_EMAIL" | grep -Eq '^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$'; then
      echo "Error: user email format is invalid: $USER_EMAIL"
      exit 1
    fi

    export XTS_ALLOCATOR_SERVER="$USER_SERVER"
    export XTS_ALLOCATOR_USER_EMAIL="$USER_EMAIL"
    export XTS_ALLOCATOR_USER_NAME="$USER_NAME"
    export XTS_ALLOCATOR_USER_OFFICE="$USER_OFFICE"
    export XTS_ALLOCATOR_USER_TEAM="$USER_TEAM"
    export XTS_ALLOCATOR_INSTANCE="$ALLOCATOR_INSTANCE"

    mkdir -p "$(dirname "$PROFILE_PATH")"
    python3 - "$PROFILE_PATH" <<'PY'
    import datetime
    import os
    import pathlib
    import sys

    profile_path = pathlib.Path(sys.argv[1])
    keys = [
        "XTS_ALLOCATOR_INSTANCE",
        "XTS_ALLOCATOR_SERVER",
        "XTS_ALLOCATOR_USER_EMAIL",
        "XTS_ALLOCATOR_USER_NAME",
        "XTS_ALLOCATOR_USER_OFFICE",
        "XTS_ALLOCATOR_USER_TEAM",
        "XTS_ALLOCATOR_TOKEN",
        "XTS_ALLOCATOR_ADMIN_TOKEN",
    ]

    existing = {}
    if profile_path.exists():
        for line in profile_path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith("export ") and "=" in line:
                left, right = line[len("export "):].split("=", 1)
                existing[left.strip()] = right.strip()

    lines = []
    lines.append("# XTS Allocator profile")
    lines.append(f"# Updated: {datetime.datetime.utcnow().isoformat()}Z")
    for key in keys:
        value = os.environ.get(key)
        if value is None:
            rendered = existing.get(key, "")
            if rendered:
                lines.append(f"export {key}={rendered}")
            continue
        lines.append(f"export {key}={value!r}")

    profile_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    PY
    chmod 600 "$PROFILE_PATH" 2>/dev/null || true

    echo ""
    echo "Instance: $ALLOCATOR_INSTANCE"
    echo "Profile saved: $PROFILE_PATH"
    echo "Current shell updated."
    echo ""
    echo "Recommended:"
    echo "  source \"$PROFILE_PATH\""
    echo "  xts allocator whoami"
    echo ""
  params:
    passthrough: true

xts_allocator_register:
  description: |
    Explicit register command alias (same as 'register').

    Usage: xts allocator xts_allocator_register [instance]
  command: |
    xts ${XTS_ALIAS_NAME:-allocator} register "$@"
  params:
    passthrough: true

whoami:
  description: |
    Show current allocator identity/profile values.

    Usage: xts allocator whoami
  command: |
    ALLOCATOR_INSTANCE="${XTS_ALLOCATOR_INSTANCE:-${XTS_ALIAS_NAME:-allocator}}"
    PROFILE_DIR="${XTS_ALLOCATOR_PROFILE_DIR:-$HOME/.xts/config/allocators}"
    PROFILE_PATH="${XTS_ALLOCATOR_PROFILE:-${PROFILE_DIR}/${ALLOCATOR_INSTANCE}.env}"
    if [ -f "$PROFILE_PATH" ]; then
      # shellcheck disable=SC1090
      . "$PROFILE_PATH"
    fi
    echo "{"
    echo "  \"server\": \"${XTS_ALLOCATOR_SERVER:-http://localhost:5000}\","
    echo "  \"email\": \"${XTS_ALLOCATOR_USER_EMAIL:-}\","
    echo "  \"name\": \"${XTS_ALLOCATOR_USER_NAME:-}\","
    echo "  \"office\": \"${XTS_ALLOCATOR_USER_OFFICE:-}\","
    echo "  \"team\": \"${XTS_ALLOCATOR_USER_TEAM:-}\","
    echo "  \"instance\": \"${XTS_ALLOCATOR_INSTANCE:-$ALLOCATOR_INSTANCE}\","
    echo "  \"profile\": \"$PROFILE_PATH\""
    echo "}"

help_commands:
  description: |
    Show command catalog with descriptions and known switches.
    Useful when shell completion cannot display descriptions inline.

    Usage: xts allocator help_commands
  command: |
    CONFIG_PATH="${XTS_CONFIG_PATH:-${XTS_ALIAS_SOURCE:-}}"
    if [ -z "$CONFIG_PATH" ] || [ ! -f "$CONFIG_PATH" ]; then
      ALIAS_NAME="${XTS_ALIAS_NAME:-allocator}"
      ALIASES_FILE="$HOME/.xts/aliases.json"
      if [ -f "$ALIASES_FILE" ]; then
        CANDIDATE_PATH="$(python3 - "$ALIASES_FILE" "$ALIAS_NAME" <<'PY'
    import json
    import sys

    aliases_file = sys.argv[1]
    alias_name = sys.argv[2]
    try:
        with open(aliases_file, "r", encoding="utf-8") as f:
            aliases = json.load(f) or {}
        value = aliases.get(alias_name, "")
        if isinstance(value, str):
            print(value)
    except Exception:
        pass
    PY
        )"
        if [ -n "$CANDIDATE_PATH" ] && [ -f "$CANDIDATE_PATH" ]; then
          CONFIG_PATH="$CANDIDATE_PATH"
        fi
      fi
    fi
    if [ -z "$CONFIG_PATH" ] || [ ! -f "$CONFIG_PATH" ]; then
      for candidate in "./xts_allocator.xts" "./config/xts_allocator.xts"; do
        if [ -f "$candidate" ]; then
          CONFIG_PATH="$candidate"
          break
        fi
      done
    fi
    if [ -z "$CONFIG_PATH" ] || [ ! -f "$CONFIG_PATH" ]; then
      echo "Unable to read config metadata (XTS_CONFIG_PATH not set)."
      echo "Use: xts ${XTS_ALIAS_NAME:-allocator} --help"
      exit 0
    fi
    python3 - "$CONFIG_PATH" <<'PY'
    import re
    import sys
    import yaml

    cfg_path = sys.argv[1]
    with open(cfg_path, "r", encoding="utf-8") as f:
        data = yaml.safe_load(f) or {}

    if isinstance(data.get("commands"), dict):
        commands = data["commands"]
    else:
        reserved = {"brief", "schema_version", "version", "changelog", "functions", "commands", "command_groups"}
        commands = {k: v for k, v in data.items() if isinstance(v, dict) and "command" in v and k not in reserved}

    command_groups = data.get("command_groups", {})
    
    print("\n\033[1musage:\033[0m xts allocator <command> [options]\n")
    
    # Display grouped commands if groups are defined
    if command_groups:
        first_group = True
        for group_key, group_data in command_groups.items():
            # Add spacing between groups
            if not first_group:
                print()
            first_group = False
            
            title = group_data.get("title", group_key)
            description = group_data.get("description", "")
            group_commands = group_data.get("commands", [])
            
            print(f"\033[1m\033[33m{title.lower()}:\033[0m")
            if description:
                print(f"  \033[2m{description}\033[0m")
            print()
            
            for cmd_name in group_commands:
                if cmd_name in commands:
                    details = commands[cmd_name] or {}
                    desc = str(details.get("description", "")).strip().splitlines()[0] if details.get("description") else ""
                    # Clean up description - remove common prefix patterns
                    import re
                    desc = re.sub(r'^Usage:\s*xts\s+\w+\s+\w+.*', '', desc, flags=re.IGNORECASE).strip()
                    if desc:
                        print(f"  \033[1;32m{cmd_name:28}\033[0m \033[2m{desc}\033[0m")
        print()
    else:
        # Fallback to alphabetical list if no groups
        print("\033[1m\033[96mAllocator Commands\033[0m\n")
        for name in sorted(commands.keys()):
            details = commands.get(name, {}) or {}
            desc = str(details.get("description", "")).strip().splitlines()[0] if details.get("description") else ""
            print(f"\033[1;32m{name:26}\033[0m \033[2m{desc}\033[0m")
        print()
    PY

alloc:
  description: |
    Allocate using registered profile identity (email/name/office/team).
    Target can be numeric device id, target_id (platform@rack/slot), or platform.

    Usage: xts allocator alloc <target> <duration>

    Examples:
      xts allocator alloc 5 2h
      xts allocator alloc Cisco@TestRack1/Slot1 2h
      xts allocator alloc llama 90m
  command: |
    ALLOCATOR_INSTANCE="${XTS_ALLOCATOR_INSTANCE:-${XTS_ALIAS_NAME:-allocator}}"
    PROFILE_DIR="${XTS_ALLOCATOR_PROFILE_DIR:-$HOME/.xts/config/allocators}"
    PROFILE_PATH="${XTS_ALLOCATOR_PROFILE:-${PROFILE_DIR}/${ALLOCATOR_INSTANCE}.env}"
    if [ -f "$PROFILE_PATH" ]; then
      # shellcheck disable=SC1090
      . "$PROFILE_PATH"
    fi
    if [ -z "${XTS_ALLOCATOR_USER_EMAIL:-}" ]; then
      echo "Error: no registered user email."
      echo "Run: xts allocator register"
      exit 1
    fi
    TARGET="$1"
    DURATION="$2"
    PAYLOAD=$(TARGET="$TARGET" DURATION="$DURATION" python3 -c "import json, os; target=os.environ['TARGET']; duration=os.environ['DURATION']; slot={}; user={'email': os.environ.get('XTS_ALLOCATOR_USER_EMAIL','')}; name=os.environ.get('XTS_ALLOCATOR_USER_NAME','').strip(); office=os.environ.get('XTS_ALLOCATOR_USER_OFFICE','').strip(); team=os.environ.get('XTS_ALLOCATOR_USER_TEAM','').strip(); user.update({'name': name} if name else {}); user.update({'office': office} if office else {}); user.update({'team': team} if team else {}); slot.update({'id': int(target)} if target.isdigit() else ({'target_id': target} if ('@' in target or '/' in target) else {'platform': target})); print(json.dumps({'user': user, 'slot': slot, 'duration': duration}))")
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/allocate_slot \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD"
  params:
    passthrough: true

release_me:
  description: |
    Release device using registered profile email.

    Usage: xts allocator release_me <device_id>

    Example:
      xts allocator release_me 5
  command: |
    ALLOCATOR_INSTANCE="${XTS_ALLOCATOR_INSTANCE:-${XTS_ALIAS_NAME:-allocator}}"
    PROFILE_DIR="${XTS_ALLOCATOR_PROFILE_DIR:-$HOME/.xts/config/allocators}"
    PROFILE_PATH="${XTS_ALLOCATOR_PROFILE:-${PROFILE_DIR}/${ALLOCATOR_INSTANCE}.env}"
    if [ -f "$PROFILE_PATH" ]; then
      # shellcheck disable=SC1090
      . "$PROFILE_PATH"
    fi
    if [ -z "${XTS_ALLOCATOR_USER_EMAIL:-}" ]; then
      echo "Error: no registered user email."
      echo "Run: xts allocator register"
      exit 1
    fi
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/deallocate_slot \
      -H "Content-Type: application/json" \
      -d "{\"user\": {\"email\": \"${XTS_ALLOCATOR_USER_EMAIL}\"}, \"slot\": {\"id\": $1}}"
  params:
    passthrough: true

borrow_box:
  description: |
    Borrow a box temporarily when the default owner is unavailable.
    Works for allocated/permanent boxes that are not actively testing.

    Usage: xts allocator borrow_box <device_id> [duration] [reason]

    Examples:
      xts allocator borrow_box 5
      xts allocator borrow_box 5 2h
      xts allocator borrow_box 5 90m "owner away this week"
  command: |
    ALLOCATOR_INSTANCE="${XTS_ALLOCATOR_INSTANCE:-${XTS_ALIAS_NAME:-allocator}}"
    PROFILE_DIR="${XTS_ALLOCATOR_PROFILE_DIR:-$HOME/.xts/config/allocators}"
    PROFILE_PATH="${XTS_ALLOCATOR_PROFILE:-${PROFILE_DIR}/${ALLOCATOR_INSTANCE}.env}"
    if [ -f "$PROFILE_PATH" ]; then
      # shellcheck disable=SC1090
      . "$PROFILE_PATH"
    fi
    if [ -z "${XTS_ALLOCATOR_USER_EMAIL:-}" ]; then
      echo "Error: no registered user email."
      echo "Run: xts allocator register"
      exit 1
    fi
    DURATION="${2:-4h}"
    REASON="${3:-owner unavailable}"
    if [ "$#" -gt 3 ]; then
      REASON="$3 ${*:4}"
    fi
    PAYLOAD=$(SLOT_ID="$1" DURATION="$DURATION" REASON="$REASON" python3 -c "import json, os; u={'email': os.environ.get('XTS_ALLOCATOR_USER_EMAIL','')}; name=os.environ.get('XTS_ALLOCATOR_USER_NAME','').strip(); u.update({'name': name} if name else {}); print(json.dumps({'user': u, 'slot': {'id': int(os.environ['SLOT_ID'])}, 'duration': os.environ['DURATION'], 'reason': os.environ['REASON']}))")
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/borrow_slot \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD"
  params:
    passthrough: true

return_borrow_box:
  description: |
    Return a borrowed box to its original owner.

    Usage: xts allocator return_borrow_box <device_id>

    Example:
      xts allocator return_borrow_box 5
  command: |
    ALLOCATOR_INSTANCE="${XTS_ALLOCATOR_INSTANCE:-${XTS_ALIAS_NAME:-allocator}}"
    PROFILE_DIR="${XTS_ALLOCATOR_PROFILE_DIR:-$HOME/.xts/config/allocators}"
    PROFILE_PATH="${XTS_ALLOCATOR_PROFILE:-${PROFILE_DIR}/${ALLOCATOR_INSTANCE}.env}"
    if [ -f "$PROFILE_PATH" ]; then
      # shellcheck disable=SC1090
      . "$PROFILE_PATH"
    fi
    if [ -z "${XTS_ALLOCATOR_USER_EMAIL:-}" ]; then
      echo "Error: no registered user email."
      echo "Run: xts allocator register"
      exit 1
    fi
    PAYLOAD=$(SLOT_ID="$1" python3 -c "import json, os; u={'email': os.environ.get('XTS_ALLOCATOR_USER_EMAIL','')}; name=os.environ.get('XTS_ALLOCATOR_USER_NAME','').strip(); u.update({'name': name} if name else {}); print(json.dumps({'user': u, 'slot': {'id': int(os.environ['SLOT_ID'])}}))")
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/return_borrowed_slot \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD"
  params:
    passthrough: true

alloc_by_id:
  description: |
    Allocate device by specific ID
    
    Usage: xts allocator alloc_by_id <email> <device_id> <duration>
    
    Examples:
      xts allocator alloc_by_id user@example.com 5 2h
      xts allocator alloc_by_id test@dev.com 1 30m
      xts allocator alloc_by_id admin@test.com 10 90
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/allocate_slot \
      -H "Content-Type: application/json" \
      -d "{\"user\": {\"email\": \"$1\"}, \"slot\": {\"id\": $2}, \"duration\": \"$3\"}"
  params:
    passthrough: true

alloc_by_platform:
  description: |
    Allocate first available device matching platform
    
    Usage: xts allocator alloc_by_platform <email> <platform> <duration>
    
    Examples:
      xts allocator alloc_by_platform user@example.com alpha.uk 2h
      xts allocator alloc_by_platform test@dev.com beta.us 1h
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/allocate_slot \
      -H "Content-Type: application/json" \
      -d "{\"user\": {\"email\": \"$1\"}, \"slot\": {\"platform\": \"$2\"}, \"duration\": \"$3\"}"
  params:
    passthrough: true

alloc_by_target:
  description: |
    Allocate by unified target id (platform@rack/slot).
    Resolution order: exact rack/slot (optionally platform-qualified), then platform fallback.

    Usage: xts allocator alloc_by_target <email> <target_id> <duration>

    Examples:
      xts allocator alloc_by_target user@example.com Cisco@TestRack1/Slot1 2h
      xts allocator alloc_by_target user@example.com TestRack1/Slot1 2h
      xts allocator alloc_by_target user@example.com Cisco 2h
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/allocate_slot \
      -H "Content-Type: application/json" \
      -d "{\"user\": {\"email\": \"$1\"}, \"slot\": {\"target_id\": \"$2\"}, \"duration\": \"$3\"}"
  params:
    passthrough: true

alloc_by_tags:
  description: |
    Allocate first available device matching tags
    
    Usage: xts allocator alloc_by_tags <email> <tags> <duration>
    
    Examples:
      xts allocator alloc_by_tags user@example.com hdmi,4k 2h
      xts allocator alloc_by_tags test@dev.com production 1h
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/allocate_slot \
      -H "Content-Type: application/json" \
      -d "{\"user\": {\"email\": \"$1\"}, \"slot\": {\"tags\": [\"$2\"]}, \"duration\": \"$3\"}"
  params:
    passthrough: true

release:
  description: |
    Release an allocated device
    
    Usage: xts allocator release <email> <device_id>
    
    Examples:
      xts allocator release user@example.com 5
      xts allocator release test@dev.com 1
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/deallocate_slot \
      -H "Content-Type: application/json" \
      -d "{\"user\": {\"email\": \"$1\"}, \"slot\": {\"id\": $2}}"
  params:
    passthrough: true

label_box:
  description: |
    Add/update labels for a box (labels are aliases of tags)

    Usage: xts allocator label_box <slot_id> <labels_csv>

    Examples:
      xts allocator label_box 5 camera,ir,fan
      xts allocator label_box 8 pi4,amp,hdmi
  command: |
    if [ -z "${XTS_ALLOCATOR_TOKEN:-}" ]; then
      echo "Error: label_box requires XTS_ALLOCATOR_TOKEN."
      exit 1
    fi
    LABELS_JSON=$(python3 -c "import json,sys; print(json.dumps([x.strip() for x in sys.argv[1].split(',') if x.strip()]))" "$2")
    PAYLOAD=$(printf '{"slot_id": %s, "labels": %s}' "$1" "$LABELS_JSON")
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/update_slot \
      -H "Authorization: Bearer ${XTS_ALLOCATOR_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD"
  params:
    passthrough: true

set_slot_contents:
  description: |
    Define what is physically in the rack slot (stored as external_equipment)

    Usage: xts allocator set_slot_contents <slot_id> <contents_csv>

    Examples:
      xts allocator set_slot_contents 5 pi4,amp,fan,camera,IR Blaster Ollemxi
      xts allocator set_slot_contents 8 camera,relay,power_controller
  command: |
    if [ -z "${XTS_ALLOCATOR_TOKEN:-}" ]; then
      echo "Error: set_slot_contents requires XTS_ALLOCATOR_TOKEN."
      exit 1
    fi
    CONTENTS_JSON=$(python3 -c "import json,sys; print(json.dumps([x.strip() for x in sys.argv[1].split(',') if x.strip()]))" "$2")
    PAYLOAD=$(printf '{"slot_id": %s, "slot_contents": %s}' "$1" "$CONTENTS_JSON")
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/update_slot \
      -H "Authorization: Bearer ${XTS_ALLOCATOR_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD"
  params:
    passthrough: true

annotate_box:
  description: |
    Set labels and slot contents in one command

    Usage: xts allocator annotate_box <slot_id> <labels_csv> <contents_csv>

    Example:
      xts allocator annotate_box 5 camera,ir,fan pi4,amp,fan,camera,IR Blaster Ollemxi
  command: |
    if [ -z "${XTS_ALLOCATOR_TOKEN:-}" ]; then
      echo "Error: annotate_box requires XTS_ALLOCATOR_TOKEN."
      exit 1
    fi
    LABELS_JSON=$(python3 -c "import json,sys; print(json.dumps([x.strip() for x in sys.argv[1].split(',') if x.strip()]))" "$2")
    CONTENTS_JSON=$(python3 -c "import json,sys; print(json.dumps([x.strip() for x in sys.argv[1].split(',') if x.strip()]))" "$3")
    PAYLOAD=$(printf '{"slot_id": %s, "labels": %s, "slot_contents": %s}' "$1" "$LABELS_JSON" "$CONTENTS_JSON")
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/update_slot \
      -H "Authorization: Bearer ${XTS_ALLOCATOR_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD"
  params:
    passthrough: true

list:
  description: |
    List devices with optional query and state filtering (recommended for large fleets)

    Usage:
      xts allocator list
      xts allocator list <query>
      xts allocator list <query> --free|--busy|--allocated|--maintenance|--testing|--offline|--resetting
      xts allocator list --state=<state> <query>

    Examples:
      xts allocator list xione --free
      xts allocator list llama --busy
      xts allocator list --state=allocated

    Shows: target, state, labels, and slot contents count
  command: |
    STATE=""
    QUERY=""
    for arg in "$@"; do
      case "$arg" in
        --free) STATE="free" ;;
        --busy) STATE="busy" ;;
        --allocated) STATE="allocated" ;;
        --maintenance) STATE="maintenance" ;;
        --testing) STATE="testing" ;;
        --offline) STATE="offline" ;;
        --resetting) STATE="resetting" ;;
        --state=*) STATE="${arg#--state=}" ;;
        *)
          if [ -z "$QUERY" ]; then
            QUERY="$arg"
          else
            QUERY="$QUERY $arg"
          fi
          ;;
      esac
    done

    if [ -z "$STATE" ] && [ -z "$QUERY" ]; then
      curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots | {{format_device_list}}
    else
      PAYLOAD=$(STATE="$STATE" QUERY="$QUERY" python3 -c "import json, os; payload={}; state=os.environ.get('STATE','').strip(); query=os.environ.get('QUERY','').strip(); payload.update({'state': state} if state else {}); payload.update({'query': query} if query else {}); print(json.dumps(payload))")
      curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots \
        -H "Content-Type: application/json" \
        -d "$PAYLOAD" | {{format_device_list}}
    fi
  params:
    passthrough: true

list_targets:
  description: |
    List target identifiers for quick allocation (copy/paste into alloc_by_target)

    Usage: xts allocator list_targets
  command: |
    curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots | jq -r '
      "\n\u001b[1m\u001b[96mTargets (\(.slots | length)):\u001b[0m\n",
      "\u001b[1mID   Target                                State        Owner\u001b[0m",
      "────────────────────────────────────────────────────────────────────────────",
      (.slots[] |
        "\u001b[96m\(.slot_id | tostring | .[0:4])\u001b[0m \((.target_id // ((.platform // \"unknown\") + \"@\" + (.rackName // \"-\") + \"/\" + (.slotName // \"-\")))[0:36] | . + (\" \" * (36 - length))) \((.state // \"unknown\")[0:12] | . + (\" \" * (12 - length))) \((.owner_email // \"-\")[0:20])"
      )
    '

list_racks:
  description: |
    List all racks with device counts
    
    Usage: xts allocator list_racks
    
    Shows: Rack names and number of devices in each
  command: curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_racks | {{format_rack_list}}

list_free:
  description: |
    List only available (free) devices
    
    Usage: xts allocator list_free
    
    Example: xts allocator list_free
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots \
      -H "Content-Type: application/json" \
      -d '{"state": "free"}' | jq -r '
      "\n\u001b[1m\u001b[96mFree Devices (\(.slots | length)):\u001b[0m\n",
      "\u001b[1mID   Slot Name            Platform             State        Owner                     Expires\u001b[0m",
      "────────────────────────────────────────────────────────────────────────────────────────────────────",
      (.slots[] | 
        "\u001b[96m\(.slot_id | tostring | .[0:4])\u001b[0m \(.slotName[0:20] | . + (" " * (20 - length))) \(.platform[0:20] | . + (" " * (20 - length))) \u001b[92m\(.state)        \u001b[0m \(if .owner_email then (.owner_email[0:25] | . + (" " * (25 - length))) else "-                        " end) \(if .allocation_expiry then (.allocation_expiry[0:20] | . + (" " * (20 - length))) else "-" end)"
      )
    '

list_allocated:
  description: |
    List currently allocated devices
    
    Usage: xts allocator list_allocated
    
    Shows: Who has allocated which devices and when they expire
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots \
      -H "Content-Type: application/json" \
      -d '{"state": "allocated"}' | jq -r '
      "\n\u001b[1m\u001b[96mAllocated Devices (\(.slots | length)):\u001b[0m\n",
      "\u001b[1mID   Slot Name            Platform             State        Owner                     Expires\u001b[0m",
      "────────────────────────────────────────────────────────────────────────────────────────────────────",
      (.slots[] | 
        "\u001b[96m\(.slot_id | tostring | .[0:4])\u001b[0m \(.slotName[0:20] | . + (" " * (20 - length))) \(.platform[0:20] | . + (" " * (20 - length))) \u001b[93m\(.state)    \u001b[0m \(if .owner_email then (.owner_email[0:25] | . + (" " * (25 - length))) else "-                        " end) \(if .allocation_expiry then (.allocation_expiry[0:20] | . + (" " * (20 - length))) else "-" end)"
      )
    '

list_by_platform:
  description: |
    List devices filtered by platform
    
    Usage: xts allocator list_by_platform <platform>
    
    Examples:
      xts allocator list_by_platform alpha.uk
      xts allocator list_by_platform beta.us
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots \
      -H "Content-Type: application/json" \
      -d "{\"platform\": \"$1\"}" | {{format_device_list}}
  params:
    passthrough: true

search_by_rack:
  description: |
    Find devices in a specific rack
    
    Usage: xts allocator search_by_rack <rack_name>
    
    Examples:
      xts allocator search_by_rack rack-a
      xts allocator search_by_rack test-rack-1
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/devices/search \
      -H "Content-Type: application/json" \
      -d "{\"rack_name\": \"$1\"}" | {{format_search_results}}
  params:
    passthrough: true

search_by_platform:
  description: |
    Find devices by platform type
    
    Usage: xts allocator search_by_platform <platform>
    
    Examples:
      xts allocator search_by_platform alpha.uk
      xts allocator search_by_platform beta.us
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/devices/search \
      -H "Content-Type: application/json" \
      -d "{\"platform\": \"$1\"}" | {{format_search_results}}
  params:
    passthrough: true

search_by_tags:
  description: |
    Find devices matching tags
    
    Usage: xts allocator search_by_tags <tags>
    
    Examples:
      xts allocator search_by_tags hdmi
      xts allocator search_by_tags 4k,production
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/devices/search \
      -H "Content-Type: application/json" \
      -d "{\"tags\": \"$1\"}" | python3 -c "
    import sys, json
    data = json.load(sys.stdin)
    results = data.get('results', [])
    if not results:
        print('\\033[93mNo devices found.\\033[0m')
        sys.exit(0)
    print(f'\\n\\033[1m\\033[96mDevice List ({len(results)} devices):\\033[0m\\n')
    print('\\033[1m%-4s %-20s %-20s %-12s %-25s %-20s\\033[0m' % ('ID', 'Slot Name', 'Platform', 'State', 'Owner', 'Expires'))
    print('─' * 110)
    for r in results:
        sid = str(r.get('id', '?'))[:4]
        name = r.get('slot_name', 'Unknown')[:20]
        plat = r.get('platform', 'Unknown')[:20]
        state = r.get('state', 'unknown')
        owner = (r.get('owner_email') or '-')[:25]
        exp = r.get('allocation_expiry', '-')[:20]
        sc = '\\033[92m' if state == 'free' else ('\\033[93m' if state == 'allocated' else '\\033[0m')
        print('\\033[96m%-4s\\033[0m %-20s %-20s %s%-12s\\033[0m %-25s %-20s' % (sid, name, plat, sc, state, owner, exp))
    print('\\n' + '─' * 110)
    print('\\033[2mUse xts allocator list --verbose for more details\\033[0m')
    free = sum(1 for r in results if r.get('state') == 'free')
    alloc = sum(1 for r in results if r.get('state') == 'allocated')
    print(f'\\n\\033[1mSummary:\\033[0m \\033[92m{free} free\\033[0m, \\033[93m{alloc} allocated\\033[0m')
    "
  params:
    passthrough: true

search_boxes:
  description: |
    Free-text search across platform, rack, slot, labels/tags, make/model, and description

    Usage: xts allocator search_boxes <query>

    Examples:
      xts allocator search_boxes pi4
      xts allocator search_boxes camera
      xts allocator search_boxes testrack1
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/devices/search \
      -H "Content-Type: application/json" \
      -d "{\"query\": \"$1\"}" | {{format_search_results}}
  params:
    passthrough: true

search_by_label:
  description: |
    Search boxes by labels (alias of tags)

    Usage: xts allocator search_by_label <label>

    Examples:
      xts allocator search_by_label camera
      xts allocator search_by_label ir
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/devices/search \
      -H "Content-Type: application/json" \
      -d "{\"labels\": [\"$1\"]}" | {{format_search_results}}
  params:
    passthrough: true

search_by_equipment:
  description: |
    Search boxes by slot contents/external equipment (e.g., camera, ir_blaster, amp, fan)

    Usage: xts allocator search_by_equipment <equipment>

    Examples:
      xts allocator search_by_equipment camera
      xts allocator search_by_equipment ir_blaster
      xts allocator search_by_equipment fan
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/devices/search \
      -H "Content-Type: application/json" \
      -d "{\"has_equipment_type\": \"$1\"}" | {{format_search_results}}
  params:
    passthrough: true

describe_box:
  description: |
    Show full box/rack-slot details including labels and slot contents

    Usage: xts allocator describe_box <id|target_id>

    Examples:
      xts allocator describe_box 5
      xts allocator describe_box Cisco@TestRack1/Slot1
  command: |
    curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots | python3 -c "
    import sys, json
    q = sys.argv[1].strip().lower()
    data = json.load(sys.stdin)
    slots = data.get('slots', [])
    matches = []
    for s in slots:
      sid = str(s.get('id') or s.get('slot_id'))
      target = (s.get('target_id') or '').lower()
      if q == sid or q == target or q in target:
        matches.append(s)
    if not matches:
      print('\\033[93mNo box found for query:\\033[0m', sys.argv[1])
      sys.exit(0)
    s = matches[0]
    print('\\n\\033[1m\\033[96mBox Details\\033[0m\\n')
    print('ID:            ', s.get('id') or s.get('slot_id'))
    print('Target:        ', s.get('target_id'))
    print('Rack/Slot:     ', f\"{s.get('rackName')}/{s.get('slotName')}\")
    print('Platform:      ', s.get('platform'))
    print('State:         ', s.get('state'))
    print('Owner:         ', s.get('owner_email') or '-')
    print('Labels:        ', ', '.join(s.get('labels') or s.get('tags') or []) or '-')
    print('Description:   ', s.get('description') or '-')
    print('Make/Model:    ', f\"{s.get('make') or '-'} / {s.get('model') or '-'}\")
    contents = s.get('slot_contents') or s.get('external_equipment') or []
    print('\\nSlot Contents:')
    if not contents:
      print('  - (none)')
    else:
      for item in contents:
        if isinstance(item, dict):
          item_type = item.get('type') or 'item'
          name = item.get('name') or ''
          model = item.get('model') or ''
          details = ' '.join(x for x in [name, model] if x).strip()
          print(f\"  - {item_type}: {details}\" if details else f\"  - {item_type}\")
        else:
          print(f\"  - {item}\")
    print()
    " "$1"
  params:
    passthrough: true

get_state:
  description: |
    Get current state and ownership for a single device

    Usage: xts allocator get_state <device_id>

    Examples:
      xts allocator get_state 5
      xts allocator get_state 12
  command: |
    curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots | jq --arg id "$1" '
      (.slots // []) as $slots
      | ($slots | map(select((.id // .slot_id) == ($id|tonumber)))) as $matches
      | if ($matches | length) == 0 then
          {"error":"Device not found","device_id":($id|tonumber)}
        else
          ($matches[0] | {
            device_id: (.id // .slot_id),
            rack: .rackName,
            slot: .slotName,
            platform: .platform,
            state: .state,
            owner_email: .owner_email,
            allocation_type: .allocation_type,
            allocation_expiry: .allocation_expiry
          })
        end
    '
  params:
    passthrough: true

valid_states:
  description: |
    Show valid next states for a device based on its current state

    Usage: xts allocator valid_states <device_id>

    Examples:
      xts allocator valid_states 5
      xts allocator valid_states 12
  command: |
    curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/device/$1/valid_states
  params:
    passthrough: true

set_state:
  description: |
    Change device state (admin token required)

    Usage: xts allocator set_state <device_id> <state>

    Examples:
      xts allocator set_state 5 maintenance
      xts allocator set_state 5 free
      xts allocator set_state 8 busy

    Valid states:
      free, allocated, testing, busy, resetting, maintenance, offline
  command: |
    TOKEN="${XTS_ALLOCATOR_ADMIN_TOKEN:-${XTS_ALLOCATOR_TOKEN:-}}"
    if [ -z "$TOKEN" ]; then
      echo "Error: set_state requires admin token."
      echo "Set XTS_ALLOCATOR_ADMIN_TOKEN (or XTS_ALLOCATOR_TOKEN) and retry."
      exit 1
    fi
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/change_device_state \
      -H "Authorization: Bearer $TOKEN" \
      -H "Content-Type: application/json" \
      -d "{\"device_id\": $1, \"state\": \"$2\"}"
  params:
    passthrough: true

start_test:
  description: |
    Start a test execution on an allocated device (engineer/admin token required)

    Usage: xts allocator start_test <device_id> <test_name> [expected_duration_minutes] [test_suite]

    Examples:
      xts allocator start_test 5 smoke_boot 20 smoke
      xts allocator start_test 8 hdmi_audio_4k 45
  command: |
    if [ -z "${XTS_ALLOCATOR_TOKEN:-}" ]; then
      echo "Error: start_test requires XTS_ALLOCATOR_TOKEN."
      exit 1
    fi
    EXPECTED_DURATION="${3:-60}"
    TEST_SUITE="${4:-xts}"
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/start_test \
      -H "Authorization: Bearer ${XTS_ALLOCATOR_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "{\"device_id\": $1, \"test_name\": \"$2\", \"test_suite\": \"$TEST_SUITE\", \"expected_duration\": $EXPECTED_DURATION, \"user_email\": \"${XTS_ALLOCATOR_USER_EMAIL:-}\"}"
  params:
    passthrough: true

list_active_tests:
  description: |
    List currently running tests with elapsed runtime

    Usage: xts allocator list_active_tests [limit]

    Examples:
      xts allocator list_active_tests
      xts allocator list_active_tests 100
  command: |
    LIMIT="${1:-50}"
    curl -s "${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/test_executions?active_only=true&limit=$LIMIT" | jq -r '
      if (.test_executions | length) == 0 then
        "\u001b[93mNo active tests.\u001b[0m"
      else
        "\n\u001b[1m\u001b[96mActive Tests (\(.test_executions | length)):\u001b[0m\n",
        "\u001b[1mTest ID  Device  Test Name                      Suite                Status      Elapsed(min)\u001b[0m",
        "────────────────────────────────────────────────────────────────────────────────────────────────",
        (.test_executions[] |
          "\(.id | tostring | .[0:7] | . + (\" \" * (7 - length)))   \(.device_id | tostring | . + (\" \" * (6 - length))) \(.test_name[0:30] | . + (\" \" * (30 - length))) \((.test_suite // \"-\")[0:20] | . + (\" \" * (20 - length))) \((.status // \"running\")[0:10] | . + (\" \" * (10 - length))) \(((now - (.start_time | fromdateiso8601))/60 | floor))"
        )
      end
    '
  params:
    passthrough: true

active_test:
  description: |
    Get currently running test (if any) for a specific device

    Usage: xts allocator active_test <device_id>

    Examples:
      xts allocator active_test 5
      xts allocator active_test 12
  command: |
    curl -s "${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/test_executions?device_id=$1&active_only=true&limit=1" | jq -r --arg id "$1" '
      if (.test_executions | length) == 0 then
        {"message":"No active test","device_id":($id|tonumber)}
      else
        (.test_executions[0] | . + {elapsed_minutes: ((now - (.start_time | fromdateiso8601)) / 60 | floor)})
      end
    '
  params:
    passthrough: true

heartbeat_test:
  description: |
    Send heartbeat for an active test execution

    Usage: xts allocator heartbeat_test <test_execution_id>

    Example:
      xts allocator heartbeat_test 42
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/test_heartbeat \
      -H "Content-Type: application/json" \
      -d "{\"test_execution_id\": $1}"
  params:
    passthrough: true

heartbeat_device:
  description: |
    Send test heartbeat using device_id lookup for the active test

    Usage: xts allocator heartbeat_device <device_id>

    Example:
      xts allocator heartbeat_device 5
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/test_heartbeat \
      -H "Content-Type: application/json" \
      -d "{\"device_id\": $1}"
  params:
    passthrough: true

end_test:
  description: |
    End an active test execution (engineer/admin token required)

    Usage: xts allocator end_test <test_execution_id> [status] [exit_code]

    Examples:
      xts allocator end_test 42 success 0
      xts allocator end_test 42 failure 1
      xts allocator end_test 42 timeout
  command: |
    if [ -z "${XTS_ALLOCATOR_TOKEN:-}" ]; then
      echo "Error: end_test requires XTS_ALLOCATOR_TOKEN."
      exit 1
    fi
    STATUS="${2:-success}"
    PAYLOAD="{\"test_execution_id\": $1, \"status\": \"$STATUS\""
    if [ -n "${3:-}" ]; then
      PAYLOAD="$PAYLOAD, \"exit_code\": $3"
    fi
    PAYLOAD="$PAYLOAD}"
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/end_test \
      -H "Authorization: Bearer ${XTS_ALLOCATOR_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD"
  params:
    passthrough: true

report_heartbeat:
  description: |
    Report device heartbeat/status from test harness or agent

    Usage: xts allocator report_heartbeat <device_id> <connectivity_status> [software_version]

    Examples:
      xts allocator report_heartbeat 5 online 24.1.3
      xts allocator report_heartbeat 8 degraded
  command: |
    PAYLOAD="{\"device_id\": $1, \"connectivity_status\": \"$2\""
    if [ -n "${3:-}" ]; then
      PAYLOAD="$PAYLOAD, \"software_version\": \"$3\""
    fi
    PAYLOAD="$PAYLOAD}"
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/report_status \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD"
  params:
    passthrough: true

box_heartbeat:
  description: |
    Get box heartbeat details and current allocation/test context

    Usage: xts allocator box_heartbeat <device_id>

    Example:
      xts allocator box_heartbeat 5
  command: |
    curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/device/$1/usage_stats | jq '{
      device_id,
      rack,
      slot,
      platform,
      current_state,
      current_owner,
      connectivity_status,
      last_seen,
      allocation_type
    }'
  params:
    passthrough: true

status:
  description: |
    Check if allocator server is responding
    
    Usage: xts allocator status
    
    Returns: Server availability and basic info
  command: |
    SERVER="${XTS_ALLOCATOR_SERVER:-http://localhost:5000}"
    printf "\n\033[1m\033[96mXTS Allocator Server Status\033[0m\n"
    printf "\033[1mServer:\033[0m $SERVER\n"
    printf "\n"
    
    # Try to get rack list
    RESPONSE=$(curl -s -w "\n%{http_code}" "$SERVER/list_racks" 2>&1)
    HTTP_CODE=$(echo "$RESPONSE" | tail -1)
    BODY=$(echo "$RESPONSE" | sed '$d')
    
    if [ "$HTTP_CODE" = "200" ]; then
      printf "\033[92m✓ Server is online\033[0m\n"
      printf "\n"
      
      # Parse and display rack info
      RACK_COUNT=$(echo "$BODY" | grep -o '"name"' | wc -l)
      printf "\033[1mRacks:\033[0m $RACK_COUNT registered\n"
      
      # Try to get device count
      DEVICE_RESPONSE=$(curl -s "$SERVER/list_slots" 2>&1)
      if [ $? -eq 0 ]; then
        TOTAL=$(echo "$DEVICE_RESPONSE" | grep -o '"slot_id"' | wc -l)
        FREE=$(echo "$DEVICE_RESPONSE" | grep -c '"state"[[:space:]]*:[[:space:]]*"free"')
        ALLOCATED=$(echo "$DEVICE_RESPONSE" | grep -c '"state"[[:space:]]*:[[:space:]]*"allocated"')
        printf "\033[1mDevices:\033[0m $TOTAL total (\033[92m$FREE free\033[0m, \033[93m$ALLOCATED allocated\033[0m)\n"
      fi
    else
      printf "\033[91m✗ Server is offline or unreachable\033[0m\n"
      printf "\033[2mHTTP Status: $HTTP_CODE\033[0m\n"
      exit 1
    fi
    printf "\n"
