# XTS Allocator Commands
# Set XTS_ALLOCATOR_SERVER environment variable to point to your allocator server
# Default: http://localhost:5000

allocate:
  description: "Allocate a device from the XTS allocator server"
  by_id:
    description: "Allocate device by ID"
    command: |
      curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/allocate_slot \
        -H "Content-Type: application/json" \
        -d "{\"user\": {\"email\": \"$1\"}, \"slot\": {\"id\": $2}, \"duration\": \"$3\"}"
    params:
      passthrough: true
  by_platform:
    description: "Allocate device by platform"
    command: |
      curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/allocate_slot \
        -H "Content-Type: application/json" \
        -d "{\"user\": {\"email\": \"$1\"}, \"slot\": {\"platform\": \"$2\"}, \"duration\": \"$3\"}"
    params:
      passthrough: true
  by_tags:
    description: "Allocate device by tags (comma-separated)"
    command: |
      curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/allocate_slot \
        -H "Content-Type: application/json" \
        -d "{\"user\": {\"email\": \"$1\"}, \"slot\": {\"tags\": [\"$2\"]}, \"duration\": \"$3\"}"
    params:
      passthrough: true

deallocate:
  description: "Deallocate a device"
  command: |
    curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/deallocate_slot \
      -H "Content-Type: application/json" \
      -d "{\"user\": {\"email\": \"$1\"}, \"slot\": {\"id\": $2}}"
  params:
    passthrough: true

list:
  description: "List devices and racks"
  devices:
    description: "List all devices"
    command: curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots
  racks:
    description: "List all racks"
    command: curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_racks
  free:
    description: "List free devices"
    command: |
      curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots \
        -H "Content-Type: application/json" \
        -d '{"state": "free"}'
  allocated:
    description: "List allocated devices"
    command: |
      curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots \
        -H "Content-Type: application/json" \
        -d '{"state": "allocated"}'
  by_platform:
    description: "List devices by platform"
    command: |
      curl -s -X POST ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_slots \
        -H "Content-Type: application/json" \
        -d "{\"platform\": \"$1\"}"
    params:
      passthrough: true

search:
  description: "Search for devices"
  by_rack:
    description: "Search devices by rack name"
    command: |
      curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/devices/search?rack=$1
    params:
      passthrough: true
  by_platform:
    description: "Search devices by platform"
    command: |
      curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/devices/search?platform=$1
    params:
      passthrough: true
  by_tags:
    description: "Search devices by tags (comma-separated)"
    command: |
      curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/devices/search?tags=$1
    params:
      passthrough: true

status:
  description: "Check server status"
  command: |
    echo "Checking XTS Allocator Server..."
    curl -s ${XTS_ALLOCATOR_SERVER:-http://localhost:5000}/list_racks | head -c 100
